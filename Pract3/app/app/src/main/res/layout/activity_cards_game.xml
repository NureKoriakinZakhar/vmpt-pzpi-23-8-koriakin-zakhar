<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_screen"
    android:fillViewport="true"
    tools:context=".CardsGameActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingTop="16dp"
        android:layout_marginHorizontal="12dp"
        android:paddingEnd="0dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/textCardsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"

            android:text="@string/title_cards"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/primary_blue_dark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRules"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stateListAnimator="@null"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textCardsTitle"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/outline_soft"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/textCardsRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:paddingBottom="12dp"
                android:text="@string/cards_rules"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_muted" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stateListAnimator="@null"
            app:cardBackgroundColor="@color/surface_elevated"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardRules"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/outline_soft"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/textGameStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="52dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/status_hint"
                tools:text="Статус гри" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSlot1"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@null"
            app:cardBackgroundColor="@color/card_face_down"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toStartOf="@+id/cardSlot2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardStatus"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/card_face_down_stroke"
            app:strokeWidth="2dp">

            <TextView
                android:id="@+id/textCardSlot1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/card_back"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/card_label_on_dark" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSlot2"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@null"
            app:cardBackgroundColor="@color/card_face_down"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toStartOf="@+id/cardSlot3"
            app:layout_constraintStart_toEndOf="@+id/cardSlot1"
            app:layout_constraintTop_toTopOf="@+id/cardSlot1"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/card_face_down_stroke"
            app:strokeWidth="2dp">

            <TextView
                android:id="@+id/textCardSlot2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/card_back"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/card_label_on_dark" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSlot3"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@null"
            app:cardBackgroundColor="@color/card_face_down"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cardSlot2"
            app:layout_constraintTop_toTopOf="@+id/cardSlot1"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/card_face_down_stroke"
            app:strokeWidth="2dp">

            <TextView
                android:id="@+id/textCardSlot3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/card_back"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/card_label_on_dark" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayAgain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_play_again"
            android:textColor="@color/card_label_on_light"
            app:backgroundTint="@color/accent_gold"
            app:cornerRadius="0dp"
            app:elevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardSlot1"
            app:rippleColor="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCardsToMain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:stateListAnimator="@null"
            android:text="@string/btn_to_main"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="0dp"
            app:elevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnPlayAgain"
            app:rippleColor="@android:color/transparent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
