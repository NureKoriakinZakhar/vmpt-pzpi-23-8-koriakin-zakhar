<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_screen"
    android:paddingStart="0dp"
    android:paddingTop="16dp"
    android:paddingEnd="0dp"
    android:paddingBottom="16dp"
    tools:context=".HolidaysActivity">

    <TextView
        android:id="@+id/textHolidaysTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:letterSpacing="0.02"
        android:text="@string/title_holidays"
        android:layout_marginHorizontal="12dp"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/primary_blue_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMonthPicker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:stateListAnimator="@null"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        android:layout_marginHorizontal="12dp"
        app:rippleColor="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textHolidaysTitle"
        app:strokeColor="@color/outline_soft"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/textChooseMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_choose_month"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/primary_blue_dark" />

            <Spinner
                android:id="@+id/spinnerMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_spinner_field"
                android:padding="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHolidaysList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:stateListAnimator="@null"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnHolidaysToMain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardMonthPicker"
        app:rippleColor="@android:color/transparent"
        app:strokeColor="@color/outline_soft"
        app:strokeWidth="1dp">

        <ListView
            android:id="@+id/listHolidays"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="12dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHolidaysToMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:stateListAnimator="@null"
        android:text="@string/btn_to_main"
        android:layout_marginHorizontal="12dp"
        app:backgroundTint="@color/primary_blue"
        app:cornerRadius="0dp"
        app:elevation="0dp"
        app:rippleColor="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
